// Cloudflare deploy settings (Workers Builds runs `npx wrangler deploy` on every push).
// Your Supabase URL and anon key are NOT here: add them in the Cloudflare dashboard,
// Workers & Pages > family-app > Settings > Variables and Secrets, as SUPABASE_URL and SUPABASE_ANON_KEY.
{
  "name": "family-app",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/js/config.js"]
  },
  // Keep the variables you set in the dashboard when a new version deploys.
  "keep_vars": true,
  // Pull requests build a preview with `npx wrangler preview`, which needs this block (it can stay empty).
  "previews": {}
}
